@@ -0,0 +1,55 @@
+import type { EmailRuntime } from './runtime.js'
+import type { EmailDraftBackend } from './draft-web.js'
+import { DraftError } from './draft-store.js'
+
+/** Server-side capability shared with the workbench, never published as a client RPC. */
+export function createEmailWorkbenchService(runtime: EmailRuntime, backend: EmailDraftBackend, notifications?: { suppressPopups(): () => void }) {
+  return {
+    version: 1 as const,
+    suppressPopups(): () => void { return notifications?.suppressPopups() ?? (() => {}) },
+    accounts() {
+      try { return [...runtime.getEffectiveSettings().accounts].map(([id, account]) => ({ id, address: account.user, inboxFolder: account.inboxFolder })) }
+      catch { return [] }
+    },
+    scan(input: { account: string; folder?: string; cursor?: { uidValidity: number; lastUid: number }; limit?: number }, signal?: AbortSignal) {
+      return runtime.getPool().scanChanges(input.account, input.folder ?? '', input.cursor, input.limit ?? 20, signal)
+    },
+    async folders(account: string, signal?: AbortSignal) {
+      const result = await runtime.getPool().folders(account, false, signal)
+      return { ...result, folders: result.folders.filter(folder => folder.selectable !== false) }
+    },
+    read(account: string, folder: string, uid: number, signal?: AbortSignal) {
+      return runtime.getPool().readForWorkbench(account, folder, uid, signal)
+    },
+    downloadAttachment(account: string, folder: string, uid: number, index: number, workspaceHint?: string, signal?: AbortSignal, expectedUidValidity?: number) {
+      return runtime.getPool().downloadAttachment(account, folder, uid, index, workspaceHint, signal, expectedUidValidity)
+    },
+    drafts: {
+      async list(signal?: AbortSignal) { return (await backend.action({ action: 'list' }, signal) as { drafts: unknown[] }).drafts },
+      create(input: Record<string, unknown>, signal?: AbortSignal) { return backend.create(input, signal) },
+      async get(id: string, signal?: AbortSignal) {
+        const draft = await backend.store.get(id)
+        if (draft.state === 'sending') await backend.action({ action: 'list' }, signal)
+        return backend.action({ action: 'get', id }, signal)
+      },
+      update(id: string, revision: number, fields: Record<string, unknown>, signal?: AbortSignal) {
+        return backend.action({ ...fields, action: 'update', id, revision }, signal)
+      },
+      preview(id: string, revision: number, signal?: AbortSignal) {
+        return backend.action({ action: 'preview', id, revision }, signal)
+      },
+      resolveSend(id: string, revision: number, outcome: 'sent' | 'not_sent', confirmed: boolean, signal?: AbortSignal) {
+        return backend.action({ action: 'resolveSend', id, revision, outcome, confirmed }, signal)
+      },
+      async send(id: string, preview: string, confirmed: boolean, signal?: AbortSignal) {
+        // Only the host's authenticated human-action route may set confirmed.
+        if (confirmed !== true) throw new DraftError('请在工作台审核当前草稿并明确点击发送')
+        const draft = await backend.store.get(id)
+        if (['sent', 'uncertain'].includes(draft.state)) return { draft: await backend.action({ action: 'get', id }, signal) }
+        return backend.action({ action: 'send', id, preview, confirmed }, signal)
+      },
+    },
+  }
+}
+
+export type EmailWorkbenchService = ReturnType<typeof createEmailWorkbenchService>
